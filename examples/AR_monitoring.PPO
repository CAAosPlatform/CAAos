  <operations imported="False">
    <preprocessing>
      <signalInfo>
        <channel>0</channel>
        <label>MCA_R_To_Probe_Env</label>
        <unit>cm/s</unit>
        <type>CBFV_L</type>
      </signalInfo>
      <signalInfo>
        <channel>1</channel>
        <label>MCA_L_To_Probe_Env</label>
        <unit>cm/s</unit>
        <type>CBFV_R</type>
      </signalInfo>
      <signalInfo>
        <channel>2</channel>
        <label>Blood pressure</label>
        <unit>V</unit>
        <type>ABP</type>
      </signalInfo>
      <signalInfo>
        <channel>3</channel>
        <label>ETCO2</label>
        <unit>V</unit>
        <type>ETCO2</type>
      </signalInfo>
      <synchronize>
        <method>fixedAPB</method>
        <ABPdelay_s>0.9</ABPdelay_s>
      </synchronize>
      <calibrate>
        <channel>0</channel>
        <valMin>20.0</valMin>
        <valMax>150.0</valMax>
        <method>percentile</method>
        <segmentIndexes>None</segmentIndexes>
      </calibrate>
      <calibrate>
        <channel>1</channel>
        <valMin>20.0</valMin>
        <valMax>150.0</valMax>
        <method>percentile</method>
        <segmentIndexes>None</segmentIndexes>
      </calibrate>
      <calibrate>
        <channel>2</channel>
        <valMin>90.0</valMin>
        <valMax>140.0</valMax>
        <method>percentile</method>
        <segmentIndexes>None</segmentIndexes>
      </calibrate>
      <findRRmarks>
        <refChannel>2</refChannel>
        <method>ampd</method>
        <findPeaks>True</findPeaks>
        <findValleys>False</findValleys>
      </findRRmarks>
      <B2Bcalc>
        <resampleMethod>cubic</resampleMethod>
        <resampleRate_Hz>5.0</resampleRate_Hz>
      </B2Bcalc>
    </preprocessing>
  </operations>
